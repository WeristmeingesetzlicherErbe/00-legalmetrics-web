# ==============================
# ======   GITIGNORE   =========
# ==============================

/node_modules
/bun.lock
/test-results

/samples
samples/*

.DS_Store
/.DS_Store
.DS_Store/*

/.idea
.idea/*

/.vscode
.vscode/*

.ruff_cache/


# ==============================
# ======   GITIGNORE   =========
# ==============================


# Git identity configuration (contains email addresses)
.git-identities.conf

# Ignore all .env files
.env*
# But don't ignore the templates
!.env.example
!.env.template
!template.env
!.env.local.example
!.env.production.example
!.env.deploy.example

# Keys and certificates
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# Cloud credentials
credentials.json
service-account*.json
.aws/
.gcloud/
gha-creds-*.json

# SSH credentials
id_rsa
id_ed25519
*.pub.local

# Wallet material
*.mnemonic
*.seed
wallet.json
keystore/

# Docker Compose secret files. The Hedera operator private key is mounted from
# ./secrets/hedera_operator_key and must never be committed.
/secrets
secrets/*

# Runtime data (uploaded files)
/storage

# ==============================
# ======   GITIGNORE   =========
# ==============================

tmp
output